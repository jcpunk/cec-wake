[Unit]
Description=HDMI-CEC Wake Controller
After=graphical-session.target
ConditionPathExists=/dev/cec

[Service]
Type=notify
# The Wayland display name is auto-discovered from $XDG_RUNTIME_DIR at runtime.
# No manual WAYLAND_DISPLAY is needed.  Pin a specific display only if you
# must, via a drop-in:  systemctl --user edit cec-wake.service
#   [Service]
#   Environment=WAYLAND_DISPLAY=wayland-1
EnvironmentFile=-%h/.config/cec-wake/cec-wake.conf
# strip .py following standard behavior
ExecStart=/usr/libexec/cec_wake_daemon
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
NotifyAccess=main
WatchdogSec=20

[Install]
WantedBy=default.target
